# One .gitignore for the whole repo (all versions + shared)

# Environment variables (.env.example stays tracked)
.env
.env.*.local
.env/

# Runtime data written by the site (contact rate limits, etc.)
shared/storage/*
!shared/storage/.htaccess

# Claude Code local settings
.claude/

# OS generated files
.DS_Store
Thumbs.db

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
build/
out/
.next/
.vercel/
.cache/
.temp/
.vite/

# Logs
logs/
*.log

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Mac/Linux
*.swp
*~

# Coverage reports
coverage/
*.lcov

# Misc
*.bak
*.tmp
*.pid
*.seed
*.tgz

# Generated files
*.lock
*.zip
*.tar.gz

# Test output
test-output/
