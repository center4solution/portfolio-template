Options -Indexes
RewriteEngine On

# Force non-www (production only)
RewriteCond %{HTTP_HOST} ^www\.example\.com$ [NC]
RewriteRule ^(.*)$ https://example.com/$1 [L,R=301]

# Never expose repo files or notes from the root
RewriteRule (^|/)\.git(/|$) - [F,L]
RewriteRule ^[^/]+\.md$ - [F,L]
RewriteRule ^shared(/|$) - [F,L]

# Local preview page listing every version (localhost only, blocked in production)
RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteRule ^versions\.php$ - [L]
RewriteRule ^versions\.php$ - [F,L]

# ---------------------------------------------------------------------------
# Minute version switch: the same URL serves a different site version (1-7)
# every minute: version = (server minute mod 7) + 1. Visitors never see the
# folder name. Requests already inside /1 ... /7 are left alone (preview, and
# the css/js that each version pins to its own folder).
# ---------------------------------------------------------------------------

# Files that belong to one version only, so they never switch mid-visit
RewriteRule ^(imgs/.*|assets/imgs/.*|sitemap\.xml|robots\.txt|llms\.txt)$ 5/$1 [E=BRS_VERSION:5,L]

RewriteCond %{TIME_MIN} ^(00|07|14|21|28|35|42|49|56)$
RewriteRule ^(?![1-7](?:/|$))(.*)$ 1/$1 [E=BRS_VERSION:1,L]

RewriteCond %{TIME_MIN} ^(01|08|15|22|29|36|43|50|57)$
RewriteRule ^(?![1-7](?:/|$))(.*)$ 2/$1 [E=BRS_VERSION:2,L]

RewriteCond %{TIME_MIN} ^(02|09|16|23|30|37|44|51|58)$
RewriteRule ^(?![1-7](?:/|$))(.*)$ 3/$1 [E=BRS_VERSION:3,L]

RewriteCond %{TIME_MIN} ^(03|10|17|24|31|38|45|52|59)$
RewriteRule ^(?![1-7](?:/|$))(.*)$ 4/$1 [E=BRS_VERSION:4,L]

RewriteCond %{TIME_MIN} ^(04|11|18|25|32|39|46|53)$
RewriteRule ^(?![1-7](?:/|$))(.*)$ 5/$1 [E=BRS_VERSION:5,L]

RewriteCond %{TIME_MIN} ^(05|12|19|26|33|40|47|54)$
RewriteRule ^(?![1-7](?:/|$))(.*)$ 6/$1 [E=BRS_VERSION:6,L]

RewriteCond %{TIME_MIN} ^(06|13|20|27|34|41|48|55)$
RewriteRule ^(?![1-7](?:/|$))(.*)$ 7/$1 [E=BRS_VERSION:7,L]

# The page HTML changes every minute, so browsers must re-check it every visit
<IfModule mod_headers.c>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
